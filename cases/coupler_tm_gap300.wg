# TM modes reach further into the gap and couple over a shorter length.
# Reference: the same grid solved with a sparse eigen-solver in SciPy.
title Two 450 x 220 nm strips, 300 nm apart, quasi-TM
grid dx=0.025 dy=0.02
window width=4.0 ymin=-1.0 ymax=1.22
rect si 0.15 0.6 0 0.22
rect si -0.6 -0.15 0 0.22
field tm
coupler
expect n_even 1.858580968 2e-8
expect n_odd 1.788149442 2e-8
expect splitting 0.070431525 1e-4
expect coupling_length 11.003595294 1e-4
expect guided yes
expect cells 8880
