# Solving the whole structure and solving half of it with a mirror must give the same mode.
# Reference: the same grid solved with a sparse eigen-solver in SciPy. The two files expect the same index.
title Silicon strip 450 x 220 nm, right half with an even mirror
grid dx=0.025 dy=0.02
window width=2.4 ymin=-0.8 ymax=1.02
rect si -0.225 0.225 0 0.22
symmetry even
field te
expect neff 2.416579018 2e-8
expect confinement 0.670144512 1e-6
expect area 0.138934825 1e-5
expect rms_x 0.137806657 1e-6
expect guided yes
expect cells 4368
