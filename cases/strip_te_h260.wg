# Thicker silicon confines more strongly.
# Reference: the same grid solved with a sparse eigen-solver in SciPy. Bounds: cladding index and slab index.
title Silicon strip 450 x 260 nm, quasi-TE
grid dx=0.025 dy=0.02
window width=3.0 ymin=-1.0 ymax=1.22
rect si -0.225 0.225 0 0.26
symmetry even
field te
expect neff 2.534153258 2e-8
expect group_index 4.157002848 2e-6
expect confinement 0.725404244 1e-6
expect area 0.140483837 1e-5
expect guided yes
expect cells 6660
expect neff_between 1.444 2.962557
