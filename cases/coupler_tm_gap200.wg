# TM modes reach further into the gap and couple over a shorter length.
# Reference: the same grid solved with a sparse eigen-solver in SciPy.
title Two 450 x 220 nm strips, 200 nm apart, quasi-TM
grid dx=0.025 dy=0.02
window width=4.0 ymin=-1.0 ymax=1.22
rect si 0.1 0.55 0 0.22
rect si -0.55 -0.1 0 0.22
field tm
coupler
expect n_even 1.880353781 2e-8
expect n_odd 1.762880032 2e-8
expect splitting 0.117473748 1e-4
expect coupling_length 6.597218613 1e-4
expect guided yes
expect cells 8880
