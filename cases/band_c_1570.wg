# Longer wavelengths are less confined: the index falls.
# Reference: the same grid solved with a sparse eigen-solver in SciPy.
title Silicon strip 450 x 220 nm at 1.57 um
wavelength 1.57
grid dx=0.025 dy=0.02
window width=3.0 ymin=-1.0 ymax=1.22
rect si -0.225 0.225 0 0.22
symmetry even
field te
expect neff 2.394826180 2e-8
expect group_index 4.101807356 2e-6
expect confinement 0.659271592 1e-6
expect area 0.143079463 1e-5
expect guided yes
expect cells 6660
